{
  "version": 1,
  "author": "Antigravity Agent",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": { "flashSize": "16" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_boot",
      "top": 120,
      "left": -90,
      "attrs": { "color": "green", "label": "BOOT (GPIO 0)" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "btn_boot:1.l", "esp:0", "green", [ "h0" ] ],
    [ "btn_boot:2.l", "esp:GND.1", "black", [ "h0" ] ]
  ],
  "dependencies": {}
}
